<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Life TI Agent" Language="1046" Version="$(var.ProductVersion)" Manufacturer="Joao Victor Emmanuell" UpgradeCode="B5C74A04-90B5-4A4B-BB44-C73F18D61F62">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do Life TI Agent já está instalada." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="ProductFeature" Title="Life TI Agent" Level="1">
      <ComponentGroupRef Id="AgentFiles" />
    </Feature>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Life TI Agent" />
      </Directory>
    </Directory>
    <ComponentGroup Id="AgentFiles" Directory="INSTALLFOLDER">
      <Component Id="AgentExecutable" Guid="8CB9B302-BB95-46BD-96D4-3D4371518DD0">
        <File Id="LifeTiAgentExe" Source="$(var.BuildDir)\\LifeTiAgent.exe" KeyPath="yes" />
      </Component>
      <Component Id="AgentConfigExample" Guid="BFB08E9B-6B01-4DD3-8D1B-9118C682B8E5">
        <File Id="ConfigExample" Source="$(var.ProjectDir)\\config.example.json" KeyPath="yes" />
      </Component>
      <Component Id="AgentInstallScripts" Guid="6B204F1A-6CF3-4F5A-9498-D1A0BC86A664">
        <File Id="InstallScript" Source="$(var.ProjectDir)\\install.ps1" KeyPath="yes" />
        <File Id="InstallServiceScript" Source="$(var.ProjectDir)\\install-service.ps1" />
      </Component>
      <Component Id="AgentDocumentation" Guid="CCF0C4D3-0DC7-41B3-83CF-A47CA1A4F277">
        <File Id="Readme" Source="$(var.ProjectDir)\\README.md" KeyPath="yes" />
        <File Id="Privacy" Source="$(var.ProjectDir)\\PRIVACY.md" />
        <File Id="Security" Source="$(var.ProjectDir)\\SECURITY.md" />
      </Component>
    </ComponentGroup>
  </Product>
</Wix>
